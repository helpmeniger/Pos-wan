{
    "name": "jobniger/platform",
    "description": "JOB NIGER — plateforme de petits boulots et de services rémunérés au Niger",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-mbstring": "*",
        "ext-fileinfo": "*",
        "ext-openssl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.4"
    },
    "suggest": {
        "ext-gd": "Ré-encodage des images téléversées (fortement recommandé)",
        "ext-intl": "Formatage des nombres et translittération des slugs",
        "ext-sodium": "Hachage Argon2id (sinon repli bcrypt)"
    },
    "autoload": {
        "psr-4": { "App\\": "app/" },
        "files": ["app/Core/helpers.php"]
    },
    "autoload-dev": {
        "psr-4": { "Tests\\": "tests/" }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite Unit",
        "db:smoke": "bash tests/Database/run_schema_smoke.sh"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform-check": true
    },
    "minimum-stability": "stable"
}
