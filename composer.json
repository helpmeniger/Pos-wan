{
    "name": "verifia/verifia",
    "description": "VERIFIA — surveillance multi-sessions, analyse automatique et centre d'alertes pour la vérification de l'information",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-gd": "*",
        "ext-mbstring": "*",
        "ext-json": "*",
        "dompdf/dompdf": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "suggest": {
        "ext-exif": "Extraction des métadonnées EXIF des images importées manuellement"
    },
    "autoload": {
        "psr-4": { "Verifia\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Verifia\\Tests\\": "tests/" }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
