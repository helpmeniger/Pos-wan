{
    "name": "marwa/marwa",
    "description": "MARWA — plateforme web de taxi, livraison et repas (Niger). Aucune dépendance Composer n'est requise à l'exécution.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-mbstring": "*",
        "ext-json": "*",
        "ext-curl": "*",
        "ext-fileinfo": "*",
        "ext-gd": "*",
        "ext-openssl": "*"
    },
    "suggest": {
        "ext-zip": "Export Excel (.xlsx) et sauvegarde des fichiers",
        "ext-intl": "Formatage localisé",
        "ext-pcntl": "Test de concurrence multi-processus (Linux)"
    },
    "autoload": {
        "psr-4": { "App\\": "app/", "Tests\\": "tests/" }
    },
    "scripts": {
        "test": "php tests/run.php",
        "migrate": "php bin/migrate.php"
    }
}
