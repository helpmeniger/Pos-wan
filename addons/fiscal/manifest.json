        "fiscal.secrets": "Fiscal Connect : saisir les clés d'API et certificats (jamais les relire)",
        "fiscal.queue": "Fiscal Connect : relancer les factures en attente",
        "fiscal.reports": "Fiscal Connect : rapports fiscaux et clôtures",
        "fiscal.logs": "Fiscal Connect : journaux techniques et d'audit"
