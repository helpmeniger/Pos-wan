{
    "code": "ecole",
    "name": "Établissement scolaire / université",
    "version": "1.0.0",
    "requires": "2.3.0",
    "author": "Mahamadou Hamidou (Mohamed) — POS Marwa",
    "description": "Gestion complète d'une école, d'un collège, d'un lycée ou d'une université : élèves / étudiants, inscriptions, classes et matières, personnel et enseignants, frais de scolarité et caisse d'inscription, reçus, impayés, salaires, comptabilité, notes, moyennes, rangs et bulletins imprimables, appel et présences, pointage automatique par reconnaissance faciale (caméras) avec consentement. Mode « Établissement » : la caisse et les menus n'affichent plus les termes commerciaux.",
    "icon": "bi-mortarboard",
    "color": "#1d4ed8",
    "permissions": {
        "ecole.view": "Établissement : consulter élèves, classes et personnel",
        "ecole.manage": "Établissement : gérer élèves, classes, matières, personnel, années",
        "ecole.caisse": "Établissement : inscriptions et encaissement des frais",
        "ecole.finance": "Établissement : comptabilité, impayés, salaires, annulation de reçus",
        "ecole.notes": "Établissement : saisie des évaluations et des notes",
        "ecole.bulletins": "Établissement : bulletins (calcul, appréciations, impression)",
        "ecole.presence": "Établissement : appel, présences et pointage par caméra",
        "ecole.biometrie": "Établissement : données faciales (enregistrement, suppression, revue des passages)"
    },
    "new_roles": {
        "ecole_direction": {
            "name": "Direction d'établissement",
            "description": "Tout le module Établissement",
            "permissions": [
                "ecole.view",
