# SMART GUARD AI — Toute requête est redirigée vers public/.
# Les dossiers app/, config/, storage/, ai-service/... ne sont jamais servis.
Options -Indexes
<FilesMatch "^\.|\.(env|sql|bat|md|json|lock|py|log)$">
  Require all denied
</FilesMatch>
RewriteEngine On
RewriteRule ^public/ - [L]
RewriteRule ^(.*)$ public/$1 [L]

# Limites de téléversement (photos, vidéos de test) pour PHP exécuté en module Apache (WampServer)
<IfModule php_module>
  php_value upload_max_filesize 256M
  php_value post_max_size 260M
  php_value max_execution_time 120
  php_flag expose_php Off
  php_flag display_errors Off
</IfModule>
