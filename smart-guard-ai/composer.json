        "ext-fileinfo": "*",
        "ext-mbstring": "*",
        "ext-zip": "*"
    },
    "autoload": {
        "psr-4": { "App\\": "app/" },
        "files": ["app/helpers.php"]
    },
    "config": { "optimize-autoloader": true },
