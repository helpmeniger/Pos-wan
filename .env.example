# ============================================================
# MARWA — fichier d'environnement (copier en .env et adapter)
# Ce fichier ne doit JAMAIS être accessible depuis le Web ni versionné une fois rempli.
# ============================================================
APP_ENV=local
APP_DEBUG=true
# URL publique de l'application (sans / final). Exemples :
#   http://marwa.local               (VirtualHost recommandé)
#   http://localhost/marwa           (sous-dossier WampServer)
APP_URL=http://marwa.local
# Affiche le bandeau « Données de démonstration »
APP_DEMO=true

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=marwa
DB_USERNAME=root
DB_PASSWORD=
DB_TEST_DATABASE=marwa_test

# true OBLIGATOIRE en production (HTTPS)
SESSION_SECURE_COOKIE=false
SESSION_IDLE_MINUTES=120
SESSION_ABSOLUTE_HOURS=12
TRUSTED_PROXIES=

UPLOAD_MAX_BYTES=4194304

# Cartographie (Leaflet + OpenStreetMap)
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_HOST=https://tile.openstreetmap.org
# osrm | estimate
ROUTING_DRIVER=osrm
OSRM_URL=https://router.project-osrm.org
# nominatim | none
GEOCODING_DRIVER=nominatim
NOMINATIM_URL=https://nominatim.openstreetmap.org
GEOCODING_USER_AGENT="MARWA/1.0 (contact: votre-email@domaine.ne)"

# Notifications : log | smtp | mail
MAIL_DRIVER=log
MAIL_FROM=no-reply@marwa.local
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls
# log (aucun SMS réel envoyé)
SMS_DRIVER=log
SMS_SENDER=MARWA
WHATSAPP_DRIVER=none

# Passerelle de paiement de DÉMONSTRATION (aucun argent réel)
PAYMENT_DEMO_ENABLED=true
# Générez une valeur aléatoire : php -r "echo bin2hex(random_bytes(32));"
PAYMENT_DEMO_SECRET=changez-moi
