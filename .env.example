# =====================================================================
# POS Marwa — configuration locale. Copier ce fichier en ".env" (même dossier),
# puis renseigner les valeurs. Le fichier .env ne doit JAMAIS être placé
# dans public/ ni versionné (il est exclu par .gitignore).
# =====================================================================
APP_ENV=production
# true uniquement sur un poste de développement (affiche le détail des erreurs)
APP_DEBUG=false
# Clé secrète aléatoire (64 caractères hexadécimaux). Générée par l'installateur.
APP_KEY=
# Laisser vide pour une détection automatique (ex. http://localhost/pos-marwa/public)
APP_BASE_URL=
APP_TIMEZONE=Africa/Niamey

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=poswan
# Créez un utilisateur MySQL dédié (pas "root") avec un mot de passe robuste.
DB_USERNAME=
DB_PASSWORD=

# Durée d'inactivité avant déconnexion (minutes) et durée maximale de session (heures)
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=12
# true lorsque l'application est servie en HTTPS (cookie "Secure")
SESSION_SECURE=false

# ---------------------------------------------------------------------
# Mode SaaS (service en ligne multi-clients) — voir SAAS.md.
# Laisser SAAS_MODE=false pour une installation classique (un seul commerce).
# ---------------------------------------------------------------------
SAAS_MODE=false
# Domaine du service : site public sur ce domaine, chaque client sur <espace>.<domaine>
SAAS_DOMAIN=
# Base CENTRALE (clients, offres, paiements, console)
SAAS_DB_HOST=localhost
SAAS_DB_DATABASE=
SAAS_DB_USERNAME=
SAAS_DB_PASSWORD=
# create : base + utilisateur MySQL créés à chaque inscription (VPS) ; pool : bases préparées dans cPanel (o2switch)
SAAS_PROVISION=create
SAAS_DB_PREFIX=pmt_
SAAS_DB_USER_HOST=localhost
# Clé de chiffrement des mots de passe des bases clients : php bin/saas.php key
SAAS_KEY=
SAAS_TRIAL_DAYS=14
SAAS_EXCLUDED_ADDONS=marwa_assist,vision
