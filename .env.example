# =============================================================================
#  JOB NIGER — modèle de configuration. Copier en .env et adapter.
#  NE JAMAIS committer le fichier .env ni y mettre de vrais secrets dans ce modèle.
# =============================================================================
APP_NAME="JOB NIGER"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://job-niger.local
# Si l'application n'a pas de VirtualHost (ex : http://localhost/job-niger/public), indiquer le chemin :
APP_BASE_PATH=
# Générée par : php bin/console key:generate
APP_KEY=
APP_DEMO=false
LOG_LEVEL=info

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=job_niger
DB_USERNAME=job_niger_app
DB_PASSWORD=
DB_SOCKET=

# Base dédiée aux tests automatisés (elle est vidée et recréée par les tests)
DB_TEST_DATABASE=job_niger_test

SESSION_IDLE_MINUTES=120
SESSION_ABSOLUTE_HOURS=12
# true dès que le site est servi en HTTPS
SESSION_SECURE_COOKIE=false
SECURITY_HSTS=false
# Adresses IP des proxys inverses de confiance (séparées par des virgules)
TRUSTED_PROXIES=

MAIL_DRIVER=log
MAIL_FROM_ADDRESS=no-reply@job-niger.local
MAIL_FROM_NAME="JOB NIGER"

SMS_DRIVER=log
SMS_SENDER=JOBNIGER

# Passerelles de paiement : à renseigner UNIQUEMENT après signature d'un contrat (Phase 4)
# MOBILE_MONEY_API_URL=
# MOBILE_MONEY_MERCHANT_ID=
# MOBILE_MONEY_API_KEY=
# MOBILE_MONEY_WEBHOOK_SECRET=
