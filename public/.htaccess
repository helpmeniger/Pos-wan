# POS Marwa — règles Apache du dossier public
Options -Indexes -MultiViews
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Les fichiers existants (CSS, JS, images) sont servis directement
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L,QSA]
</IfModule>

# Interdire les fichiers sensibles éventuellement copiés par erreur
<FilesMatch "(?i)(^\.|\.(env|ini|log|sql|gz|zip|bak|sh|lock|md|json|dist)$)">
    Require all denied
</FilesMatch>

# Limites PHP (WampServer / PHP en module Apache) : vidéos et grandes photos de l'écran client.
# Sans effet (et sans erreur) si PHP fonctionne autrement : public/.user.ini prend alors le relais.
<IfModule mod_php.c>
    php_value upload_max_filesize 100M
    php_value post_max_size 110M
    php_value memory_limit 256M
</IfModule>
<IfModule mod_php7.c>
    php_value upload_max_filesize 100M
    php_value post_max_size 110M
    php_value memory_limit 256M
</IfModule>

# Application installable (manifeste web)
<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
</IfModule>
