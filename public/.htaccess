# MARWA — dossier public (DocumentRoot recommandé)
Options -Indexes -MultiViews
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Signale à l'application que les adresses propres (sans index.php) fonctionnent
    RewriteRule ^ - [E=MARWA_REWRITE:1]
    # Transmettre l'en-tête Authorization (jetons API) à PHP
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
    # Fichiers statiques servis directement, tout le reste vers le contrôleur frontal
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L,QSA]
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|svg|png|jpg|webp|woff2)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
    <Files "sw.js">
        Header set Cache-Control "no-cache"
    </Files>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Ne jamais servir de fichiers cachés ou de sauvegarde
<FilesMatch "(^\.|\.(bak|sql|log|env|ini|sh)$)">
    Require all denied
</FilesMatch>

AddType application/manifest+json .webmanifest
