# Dossier de téléversement : AUCUNE exécution de script, images uniquement.
Options -Indexes -ExecCGI
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .pl .py .cgi .asp .aspx .sh
RemoveType .php .phtml .phar
<FilesMatch "(?i)\.(php\d?|phtml|phar|pl|py|cgi|asp|aspx|sh|htaccess|svg)$">
    Require all denied
</FilesMatch>
<FilesMatch "(?i)\.(png|jpe?g|gif|webp)$">
    Header set Content-Security-Policy "default-src 'none'"
</FilesMatch>
