# MARWA — racine du projet.
# Utilisé uniquement si Apache pointe sur la racine (ex. http://localhost/marwa/).
# Tout est redirigé vers public/ ; config/, storage/, database/, .env… restent inaccessibles.
Options -Indexes
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
    RewriteRule ^(app|bin|bootstrap|config|database|deploy|docs|routes|storage|tests|vendor)(/.*)?$ - [F,L]
    RewriteRule ^\.  - [F,L]
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
<IfModule !mod_rewrite.c>
    Require all denied
</IfModule>
