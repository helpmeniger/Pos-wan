# Documents, exports, journaux et sauvegardes : accès direct interdit.
# Les fichiers sont servis uniquement par les contrôleurs PHP après contrôle des droits.
Require all denied
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
Options -Indexes -ExecCGI
RemoveHandler .php .phtml .php5 .php7 .php8 .phar
RemoveType .php .phtml .php5 .php7 .php8 .phar
