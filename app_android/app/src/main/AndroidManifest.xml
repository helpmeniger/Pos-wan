            android:theme="@style/Theme.HelpMe" />
        <activity
            android:name=".LobbyActivity"
            android:exported="false"
            android:theme="@style/Theme.HelpMe" />
        <activity
            android:name=".HistoryActivity"
            android:exported="false"
