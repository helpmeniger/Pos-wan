        <activity
            android:name=".QuizActivity"
            android:exported="false"
            android:theme="@style/Theme.HelpMe" />
        <activity android:name=".ModuleActivity" android:exported="false" android:theme="@style/Theme.HelpMe.Chat" />
        <activity android:name=".LessonReaderActivity" android:exported="false" android:theme="@style/Theme.HelpMe.Chat" />
        <activity android:name=".TipsActivity" android:exported="false" android:theme="@style/Theme.HelpMe.Chat" />
        <activity android:name=".ShortcutChallengeActivity" android:exported="false" android:theme="@style/Theme.HelpMe.Chat"
            android:screenOrientation="portrait" />
        <activity
            android:name=".AIChatActivity"
            android:exported="false"
            android:theme="@style/Theme.HelpMe.Chat"
            android:windowSoftInputMode="adjustResize|stateHidden" />

        <receiver
            android:name=".NotificationScheduler$NotificationReceiver"
            android:exported="true" />

        <activity
            android:name=".ApproActivity"
            android:exported="false" />
        <activity
            android:name=".MainActivity10"
            android:exported="false" />
        <activity
            android:name=".MainActivity9"
            android:exported="false"
            android:theme="@style/Theme.HelpMe" />
        <activity
            android:name=".MainActivity6"
