<?xml version="1.0" encoding="utf-8"?>
<!-- Styles communs HELP-ME pour les écrans en XML (mêmes valeurs que ui/Ui.java) -->
<resources>
    <style name="HM.HeaderTitle" parent="">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">24sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="HM.HeaderSub" parent="">
        <item name="android:textColor">#DCE7F7</item>
        <item name="android:textSize">15sp</item>
    </style>
    <style name="HM.Title" parent="">
        <item name="android:textColor">#1B2330</item>
        <item name="android:textSize">19sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="HM.Body" parent="">
        <item name="android:textColor">#1B2330</item>
        <item name="android:textSize">16sp</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>
    <style name="HM.Muted" parent="">
        <item name="android:textColor">#667386</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="HM.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">56dp</item>
        <item name="cornerRadius">28dp</item>
        <item name="backgroundTint">#326FBF</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="HM.Field" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxStrokeColor">#326FBF</item>
        <item name="hintTextColor">#326FBF</item>
    </style>
    <!-- Étape numérotée (trois côte à côte) -->
    <style name="HM.Step" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/hm_card</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">10dp</item>
        <item name="android:textColor">#1B2330</item>
        <item name="android:textSize">13sp</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>
    <!-- Ligne d'atout (icône + texte) -->
    <style name="HM.Feature" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">22dp</item>
        <item name="android:layout_marginEnd">22dp</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:drawablePadding">12dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textColor">#1B2330</item>
        <item name="android:textSize">15sp</item>
    </style>
    <!-- Petite statistique (classement) -->
    <style name="HM.StatChip" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:background">@drawable/hm_explain_box</item>
        <item name="android:paddingStart">9dp</item>
        <item name="android:paddingEnd">9dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:textColor">#1B2330</item>
        <item name="android:textSize">12.5sp</item>
    </style>
    <!-- Bandeau d'en-tête des écrans du quiz en ligne -->
    <style name="HM.OnlineHeader" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/hm_header</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:paddingTop">22dp</item>
        <item name="android:paddingBottom">22dp</item>
    </style>
    <!-- Menu latéral -->
    <style name="HM.NavItem" parent="">
        <item name="android:textSize">15.5sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="HM.NavItemShape" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">14dp</item>
    </style>
</resources>
