<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <shape xmlns:android="http://schemas.android.com/apk/res/android">
        <solid android:color="#3F51B5" /> <!-- Couleur de fond -->
        <stroke
            android:width="2dp"
            android:color="#3F51B5" /> <!-- Couleur de la bordure -->
        <corners android:radius="12dp" /> <!-- Bordure légèrement arrondie -->
        <padding
            android:left="8dp"
            android:top="8dp"
            android:right="8dp"
            android:bottom="8dp" /> <!-- Espacement intérieur -->
    </shape>



</selector>