<?xml version="1.0" encoding="utf-8"?>
<!-- Sites utiles : sélection de sites recommandés par HELP-ME -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F4F6FA">

    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/hm_sites_header" android:orientation="vertical"
            android:paddingHorizontal="20dp" android:paddingTop="22dp" android:paddingBottom="44dp">
            <TextView style="@style/HM.HeaderTitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Sites utiles" />
            <TextView android:id="@+id/tvSitesCount" style="@style/HM.HeaderSub" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginTop="2dp"
                android:text="Outils en ligne, études, emploi : notre sélection" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp" android:layout_marginTop="-26dp" android:background="@drawable/hm_search_box"
            android:elevation="4dp" android:gravity="center_vertical" android:orientation="horizontal"
            android:paddingStart="16dp" android:paddingEnd="12dp">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_m_search"
                app:tint="#667386" android:contentDescription="Rechercher" />
            <EditText android:id="@+id/etSearch" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:background="@null" android:hint="Rechercher un site (PDF, emploi, cours…)"
                android:importantForAutofill="no" android:inputType="text" android:paddingStart="10dp"
                android:paddingVertical="14dp" android:singleLine="true" android:textColor="#1B2330"
                android:textColorHint="#667386" android:textSize="15.5sp" />
        </LinearLayout>

        <LinearLayout android:id="@+id/loadingRow" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal" android:layout_marginTop="14dp" android:gravity="center_vertical"
            android:orientation="horizontal">
            <ProgressBar android:id="@+id/progressBar02" android:layout_width="22dp" android:layout_height="22dp"
                android:indeterminateTint="#0F8A5F" android:visibility="gone" />
            <TextView android:id="@+id/tvLoading" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="8dp" android:text="Mise à jour de la liste…" android:textColor="#667386"
                android:textSize="13.5sp" android:visibility="gone" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerView" android:layout_width="match_parent"
            android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false"
            android:paddingHorizontal="16dp" android:paddingTop="6dp" android:paddingBottom="96dp" />
    </LinearLayout>

    <!-- Proposer un site (formulaire repliable) -->
    <LinearLayout android:id="@+id/formCard" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom" android:background="@drawable/hm_sheet" android:elevation="16dp"
        android:orientation="vertical" android:padding="20dp" android:visibility="gone">
        <TextView style="@style/HM.Title" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Proposer un site" />
        <TextView style="@style/HM.Muted" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:text="Il sera visible par tous les apprenants." />
        <com.google.android.material.textfield.TextInputLayout style="@style/HM.Field" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="Nom du site">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etTitle" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:inputType="textCapSentences" android:maxLength="60" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout style="@style/HM.Field" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="Adresse (https://…)">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etLink" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:inputType="textUri" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout style="@style/HM.Field" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="À quoi sert-il ?">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etDescription" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:inputType="textMultiLine|textCapSentences" android:maxLength="300" />
        </com.google.android.material.textfield.TextInputLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/btnCancelAdd"
                style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1" android:text="Annuler" android:textAllCaps="false"
                android:textColor="#667386" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnAdd" style="@style/HM.Button"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2"
                android:text="Ajouter le site" app:backgroundTint="#0F8A5F" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.button.MaterialButton android:id="@+id/btnPropose" style="@style/HM.Button"
        android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|end"
        android:layout_margin="18dp" android:paddingHorizontal="22dp" android:text="Proposer un site"
        app:backgroundTint="#0F8A5F" app:elevation="6dp" app:icon="@android:drawable/ic_input_add" app:iconTint="#FFFFFF" />
</FrameLayout>
