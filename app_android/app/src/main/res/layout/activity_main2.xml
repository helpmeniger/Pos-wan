<?xml version="1.0" encoding="utf-8"?>
<!-- Écran d'accueil après connexion : présentation de HELP-ME et bouton Commencer -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6FA"
    android:fillViewport="true"
    tools:context=".MainActivity2">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Bandeau : marque, compte -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/hm_header"
            android:paddingHorizontal="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="120dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.04"
                    android:text="HELP-ME"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <!-- Compte : touchez pour afficher l'adresse et le nombre d'ouvertures -->
                <LinearLayout
                    android:id="@+id/cardToggleInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/hm_glass_pill"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="6dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mon compte"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/btnExpandInfo"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginStart="2dp"
                        android:contentDescription="Afficher mon compte"
                        android:src="@drawable/ic_expand_more"
                        app:tint="#FFFFFF" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/containerUserInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="52dp"
                android:background="@drawable/hm_glass_pill"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/userdetails"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_person_24"
                    android:drawablePadding="8dp"
                    android:drawableTint="#FFFFFF"
                    android:gravity="center_vertical"
                    android:text="—"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/textnombre"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#DCE7F7"
                    android:textSize="13sp" />
            </LinearLayout>
        </FrameLayout>

        <!-- Carte de présentation -->
        <LinearLayout
            android:id="@+id/mainCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="-100dp"
            android:background="@drawable/hm_card"
            android:elevation="6dp"
            android:orientation="vertical"
            android:paddingBottom="22dp">

            <ImageView
                android:id="@+id/imageView2"
                android:layout_width="match_parent"
                android:layout_height="230dp"
                android:layout_marginHorizontal="12dp"
                android:layout_marginTop="12dp"
                android:contentDescription="Une apprenante avec le manuel HELP-ME"
                android:scaleType="fitCenter"
                android:src="@drawable/fillebook" />

            <TextView
                android:id="@+id/textTitle"
                style="@style/HM.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="22dp"
                android:layout_marginTop="14dp"
                android:text="Apprendre l’informatique de bureau"
                android:textSize="23sp" />

            <TextView
                android:id="@+id/textSubtitle"
                style="@style/HM.Muted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="22dp"
                android:layout_marginTop="6dp"
                android:lineSpacingMultiplier="1.2"
                android:text="Le manuel et l’application avancent ensemble : lisez, scannez, pratiquez."
                android:textSize="15sp" />

            <!-- Ce que propose l'application -->
            <TextView style="@style/HM.Feature" android:drawableStart="@drawable/ic_feat_book"
                android:text="Toutes les leçons du manuel, avec captures et exercices" />
            <TextView style="@style/HM.Feature" android:drawableStart="@drawable/ic_feat_scan"
                android:text="Scannez un code-barres du manuel pour ouvrir la leçon" />
            <TextView style="@style/HM.Feature" android:drawableStart="@drawable/ic_feat_chat"
                android:text="Un assistant qui répond sans connexion Internet" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button"
                style="@style/HM.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="22dp"
                android:layout_marginTop="22dp"
                android:text="Commencer"
                app:icon="@drawable/ic_m_next"
                app:iconGravity="textEnd"
                app:iconTint="#FFFFFF" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="18dp"
            android:gravity="center"
            android:text="Astuce : secouez le téléphone pour ouvrir le scanner."
            android:textColor="#8793A6"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
