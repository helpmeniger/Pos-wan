<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity2"
    android:background="@color/lavender">



    <!-- Zone infos utilisateur -->
    <LinearLayout
        android:id="@+id/containerUserInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="16dp"
        android:visibility="gone"
        tools:ignore="MissingConstraints">

        <!-- Card Email -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardUserDetails"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardElevation="8dp"
            app:cardCornerRadius="8dp"
            android:layout_marginBottom="5dp">

            <TextView
                android:id="@+id/userdetails"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="mohamed@niamey.com"
                android:textSize="20sp"
                android:textStyle="bold"/>
        </androidx.cardview.widget.CardView>

        <!-- Card Nombre -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardUsageCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardElevation="8dp"
            app:cardCornerRadius="8dp">

            <TextView
                android:id="@+id/textnombre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="N° : 0"
                android:textSize="18sp" />
        </androidx.cardview.widget.CardView>
    </LinearLayout>


    <!-- CARTE BLANCHE MODERNE -->
    <androidx.cardview.widget.CardView
        android:id="@+id/mainCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginHorizontal="24dp"
        android:layout_marginVertical="100dp"
        app:cardCornerRadius="50dp"
        app:cardElevation="10dp"
        android:backgroundTint="@android:color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="20dp">
            <androidx.cardview.widget.CardView
                android:id="@+id/cardToggleInfo"
                android:layout_width="60dp"
                android:layout_height="60dp"
                app:cardCornerRadius="100dp"
                app:cardElevation="6dp"
                android:layout_gravity="center"
                android:backgroundTint="@color/lavender"
                android:clickable="true"
                android:foreground="?android:attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:id="@+id/btnExpandInfo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="10dp"
                    app:srcCompat="@drawable/ic_expand_more"/>
            </androidx.cardview.widget.CardView>


            <!-- Image Apprenant (remplit toute la largeur de la carte) -->
            <ImageView
                android:id="@+id/imageView2"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:src="@drawable/fillebook"
                android:adjustViewBounds="true"
                android:scaleType="centerCrop"
                android:layout_marginTop="16dp"
                android:contentDescription="Image étudiant"/>

            <!-- Titre -->
            <TextView
                android:id="@+id/textTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Démarrez l’apprentissage"
                android:textStyle="bold"
                android:textColor="#1A1A1A"
                android:textSize="22sp"
                android:layout_marginTop="16dp"/>

            <!-- Sous-texte -->
            <TextView
                android:id="@+id/textSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Explorez les cours et les ressources\npour commencer votre apprentissage."
                android:textAlignment="center"
                android:textColor="#555555"
                android:textSize="14sp"
                android:layout_marginTop="6dp"/>

            <!-- Bouton COMMENCER -->
            <Button
                android:id="@+id/button"
                android:layout_width="220dp"
                android:layout_height="55dp"
                android:text="Commencez"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:backgroundTint="@color/lavender"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:background="@drawable/corner_btn"
                android:layout_marginTop="20dp"
                android:elevation="8dp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
