<?xml version="1.0" encoding="utf-8"?>
<!-- Quiz en ligne : choix du pseudo (une seule fois) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F4F6FA" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/hm_header"
        android:gravity="center_horizontal" android:orientation="vertical" android:paddingTop="48dp" android:paddingBottom="70dp">
        <ImageView android:layout_width="84dp" android:layout_height="84dp" android:background="@drawable/hm_glass_circle"
            android:padding="22dp" android:src="@drawable/ic_m_people" android:contentDescription="Quiz en ligne" />
        <TextView style="@style/HM.HeaderTitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:text="Quiz en ligne" />
        <TextView style="@style/HM.HeaderSub" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:text="Affrontez d’autres apprenants en direct" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="18dp"
        android:layout_marginTop="-40dp" android:background="@drawable/hm_card" android:elevation="6dp" android:orientation="vertical"
        android:padding="22dp">
        <TextView style="@style/HM.Title" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Choisissez votre nom de joueur" android:textSize="18sp" />
        <TextView style="@style/HM.Muted" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:text="Il s’affiche dans le salon et le classement. Vous ne le saisissez qu’une fois." />
        <com.google.android.material.textfield.TextInputLayout style="@style/HM.Field" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="16dp" android:hint="Nom de joueur"
            app:counterEnabled="true" app:counterMaxLength="20" app:startIconDrawable="@drawable/ic_person_24">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etName" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:inputType="textPersonName|textCapWords" android:maxLength="20" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnStart" style="@style/HM.Button"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:text="Entrer dans le salon" app:icon="@drawable/ic_m_next" app:iconGravity="textEnd" app:iconTint="#FFFFFF" />
    </LinearLayout>
</LinearLayout>
