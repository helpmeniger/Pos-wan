<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingTop="24dp"
    android:paddingBottom="16dp"
    android:paddingHorizontal="16dp"
    android:background="@color/premium_ink">


    <!-- Titre -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Développez vos compétences"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:textSize="22sp"
        android:letterSpacing="0.02"
        android:layout_marginBottom="12dp" />



    <!-- Carte progression -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardContinue"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        app:cardCornerRadius="22dp"
        app:strokeColor="#C9A046"
        app:strokeWidth="1dp"
        android:layout_marginBottom="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="18dp"
            android:background="@color/lavender">

            <TextView
                android:id="@+id/tvProgressTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reprenez là où vous vous êtes arrêté"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"/>


            <TextView
                android:id="@+id/tvProgressSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/tvProgressTitle"
                android:layout_marginTop="6dp"
                android:text="Aucun quiz démarré"
                android:textColor="#BFD4FF"
                android:textSize="14sp"/>


            <!-- Bouton Continuer -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnContinue"
                android:layout_width="wrap_content"
                android:layout_height="35dp"
                android:clickable="true"
                android:layout_alignParentBottom="true"
                android:layout_alignParentEnd="true"
                android:text="Continuer"
                android:textColor="#0C1A3B"
                android:textStyle="bold"
                android:paddingHorizontal="22dp"
                android:background="@drawable/corner_btn"
                app:backgroundTint="@color/white"
                app:cornerRadius="18dp"
                app:iconPadding="0dp"
                android:layout_marginBottom="8dp"/>

            <!-- Progress Bar -->
            <TextView
                android:id="@+id/tvCategorySummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/pbHero"
                android:layout_marginTop="-68dp"
                android:gravity="center"
                android:text="Catégories complétées : 0 sur 0"
                android:textColor="@color/premium_ink"
                android:textSize="14sp" />

            <ProgressBar
                android:id="@+id/pbHero"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_alignParentBottom="true"
                android:progress="0"
                android:max="100"
                android:progressDrawable="@drawable/pb_gold_rounded"
                android:background="@drawable/pb_bg_rounded"/>
        </RelativeLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Carte progression (héros) -->
    <TextView
        android:id="@+id/tvTitle1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Modules"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:textSize="22sp"
        android:letterSpacing="0.02"
        android:layout_marginBottom="14dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1">

        <GridLayout
            android:id="@+id/gridMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:useDefaultMargins="true">

            <!-- TEMPLATE CARTE -->
            <!-- ORDINATEUR -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="90dp"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                app:cardCornerRadius="22dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@android:color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:gravity="center_vertical">

                    <ImageButton
                        android:id="@+id/ordi"
                        android:clickable="true"
                        android:layout_width="55dp"
                        android:layout_height="55dp"
                        android:foreground="?attr/selectableItemBackgroundBorderless"
                        android:background="@drawable/ic_mod_computer"
                        android:contentDescription="Ordinateur" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="10dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Ordinateur"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:textColor="@color/premium_ink"
                            android:maxLines="1"
                            android:ellipsize="end" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Bases &amp; Internet"
                            android:textSize="13sp"
                            android:textColor="#828B9C"
                            android:maxLines="2"
                            android:inputType="textMultiLine"
                            android:ellipsize="none" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- WORD -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="90dp"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                app:cardCornerRadius="22dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@android:color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:gravity="center_vertical">

                    <ImageButton
                        android:foreground="?attr/selectableItemBackgroundBorderless"

                        android:id="@+id/msword"
                        android:clickable="true"
                        android:layout_width="55dp"
                        android:layout_height="55dp"
                        android:background="@drawable/ic_mod_word"
                        android:contentDescription="Word" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="10dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Word"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:textColor="@color/premium_ink"
                            android:maxLines="1"
                            android:ellipsize="end" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Rédaction &amp; mise en page"
                            android:textSize="13sp"
                            android:textColor="#828B9C"
                            android:maxLines="2"
                            android:inputType="textMultiLine"
                            android:ellipsize="none" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- EXCEL -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="90dp"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                app:cardCornerRadius="22dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@android:color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:gravity="center_vertical">

                    <ImageButton
                        android:id="@+id/msexcel"
                        android:clickable="true"
                        android:foreground="?attr/selectableItemBackgroundBorderless"

                        android:layout_width="55dp"
                        android:layout_height="55dp"
                        android:background="@drawable/ic_mod_excel"
                        android:contentDescription="Excel" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="10dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Excel"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:textColor="@color/premium_ink"
                            android:maxLines="1"
                            android:ellipsize="end" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Tableurs &amp; Calculs"
                            android:textSize="13sp"
                            android:textColor="#828B9C"
                            android:maxLines="2"
                            android:inputType="textMultiLine"
                            android:ellipsize="none" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- POWERPOINT -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="90dp"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                app:cardCornerRadius="22dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@android:color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:gravity="center_vertical">

                    <ImageButton
                        android:id="@+id/mspoint"
                        android:clickable="true"
                        android:foreground="?attr/selectableItemBackgroundBorderless"

                        android:layout_width="55dp"
                        android:layout_height="55dp"
                        android:background="@drawable/ic_mod_powerpoint"
                        android:contentDescription="PowerPoint" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="10dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="PowerPoint"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:textColor="@color/premium_ink"
                            android:maxLines="1"
                            android:ellipsize="end" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Présentations visuelles"
                            android:textSize="13sp"
                            android:textColor="#828B9C"
                            android:maxLines="2"
                            android:inputType="textMultiLine"
                            android:ellipsize="none" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- WINDOWS -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="90dp"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                app:cardCornerRadius="22dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@android:color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:gravity="center_vertical">

                    <ImageButton
                        android:id="@+id/windows"
                        android:clickable="true"
                        android:foreground="?attr/selectableItemBackgroundBorderless"

                        android:layout_width="55dp"
                        android:layout_height="55dp"
                        android:background="@drawable/ic_mod_windows"
                        android:contentDescription="Windows" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="10dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Windows"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:textColor="@color/premium_ink"
                            android:maxLines="1"
                            android:ellipsize="end" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Système &amp; Pratique"
                            android:textSize="13sp"
                            android:textColor="#828B9C"
                            android:maxLines="2"
                            android:inputType="textMultiLine"
                            android:ellipsize="none" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Assistant IA -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="90dp"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                app:cardCornerRadius="22dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@android:color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:gravity="center_vertical">
                    <ProgressBar
                        android:id="@+id/loadingQuiz"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:indeterminateTint="@color/lavender"
                        android:indeterminate="true"
                        android:layout_centerInParent="true"
                        android:visibility="gone"
                        style="?android:attr/progressBarStyleLarge" />

                    <TextView
                        android:id="@+id/loadingQuizText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chargement..."
                        android:textSize="10sp"
                        android:layout_centerHorizontal="true"
                        android:layout_below="@id/loadingQuiz"
                        android:paddingTop="10dp"
                        android:visibility="gone"/>
                    <ImageButton
                        android:id="@+id/iaid"
                        android:clickable="true"
                        android:layout_width="55dp"
                        android:foreground="?attr/selectableItemBackgroundBorderless"

                        android:layout_height="55dp"
                        android:background="@drawable/ic_mod_ai"
                        android:contentDescription="Assistant IA" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="10dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Assistant IA"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:textColor="@color/premium_ink"
                            android:maxLines="1"
                            android:ellipsize="end" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Posez vos questions"
                            android:textSize="13sp"
                            android:textColor="#828B9C"
                            android:maxLines="2"
                            android:inputType="textMultiLine"
                            android:ellipsize="none" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ASTUCES -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="90dp"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                app:cardCornerRadius="22dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@android:color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:gravity="center_vertical">

                    <ImageButton
                        android:clickable="true"
                        android:id="@+id/msastuce"
                        android:foreground="?attr/selectableItemBackgroundBorderless"

                        android:layout_width="55dp"
                        android:layout_height="55dp"
                        android:background="@drawable/ic_mod_tips"
                        android:contentDescription="Astuces" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="10dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Astuces"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:textColor="@color/premium_ink"
                            android:maxLines="1"
                            android:ellipsize="end" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Conseils &amp; Techniques"
                            android:textSize="13sp"
                            android:textColor="#828B9C"
                            android:maxLines="2"
                            android:inputType="textMultiLine"
                            android:ellipsize="none" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- EXERCICES -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="90dp"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                app:cardCornerRadius="22dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@android:color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:gravity="center_vertical">

                    <ImageButton
                        android:clickable="true"
                        android:id="@+id/quiz2"
                        android:layout_width="55dp"
                        android:foreground="?attr/selectableItemBackgroundBorderless"
                        android:layout_height="55dp"
                        android:background="@drawable/ic_mod_exercises"
                        android:contentDescription="Exercices" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="10dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Exercices"
                            android:textStyle="bold"
                            android:textSize="15sp"
                            android:textColor="@color/premium_ink"
                            android:maxLines="1"
                            android:ellipsize="end" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Testez vos compétences"
                            android:textSize="13sp"
                            android:textColor="#828B9C"
                            android:maxLines="2"
                            android:inputType="textMultiLine"
                            android:ellipsize="none" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </GridLayout>


    </ScrollView>



</LinearLayout>
