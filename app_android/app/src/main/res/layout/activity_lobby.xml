<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swiperefresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:background="@color/bg_dark"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- HEADER -->
        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvTitle"
                android:text="🎮 Lobby"
                android:textColor="@color/on_surface"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvHistoryLink"
                android:text="Historique"
                android:textColor="@color/primary"
                android:textStyle="bold"
                android:textSize="16sp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:layout_marginStart="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tvLeaderboardLink"
                android:text="Classement"
                android:textColor="@color/primary"
                android:textStyle="bold"
                android:textSize="16sp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:layout_marginStart="16dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Zone du dernier match -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:padding="12dp"
            android:backgroundTint="@color/surface">

            <TextView
                android:id="@+id/tvLastMatch"
                android:text="Dernier match : en cours de chargement..."
                android:textColor="@color/on_surface"
                android:textSize="14sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Recherche joueur -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSearchingPlayers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_margin="12dp"
            app:cardElevation="6dp"
            android:padding="16dp"
            app:cardCornerRadius="14dp"
            android:backgroundTint="@color/primary_dark">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Patientez… Nous recherchons des joueurs disponibles"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="16sp"/>
        </com.google.android.material.card.MaterialCardView>

        <!-- 🔥 ProgressBar sous la carte -->
        <ProgressBar
            android:id="@+id/loadingplayers"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center_horizontal"
            android:visibility="gone"
            android:padding="8dp"
            android:indeterminateTint="@color/lavender"
            android:indeterminate="true"
            style="@android:style/Widget.DeviceDefault.Light.ProgressBar.Large"/>

        <!-- Etat internet -->
        <TextView
            android:id="@+id/tvNetStatus"
            android:text=""
            android:textColor="@color/on_surface_variant"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <!-- Compteur joueurs -->
        <TextView
            android:id="@+id/tvAvailableCount"
            android:text="Disponibles: 0"
            android:textColor="@color/on_surface_variant"
            android:textSize="14sp"
            android:layout_marginBottom="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <!-- LISTE DES UTILISATEURS -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/usersContainer"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </ScrollView>

    </LinearLayout>

</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
