<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="10dp" android:background="@drawable/hm_card" android:elevation="1dp"
    android:orientation="vertical" android:padding="16dp">
    <TextView android:id="@+id/titleTextView" style="@style/HM.Title" android:textSize="16.5sp"
        android:layout_width="match_parent" android:layout_height="wrap_content" />
    <TextView android:id="@+id/contentTextView" style="@style/HM.Body" android:textSize="15sp"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" />
</LinearLayout>
