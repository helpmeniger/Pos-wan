<?xml version="1.0" encoding="utf-8"?>
<!-- Message du forum : initiales, nom, bulle, heure -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/container" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:paddingVertical="5dp">
    <TextView android:id="@+id/tvAvatar" android:layout_width="34dp" android:layout_height="34dp"
        android:layout_marginEnd="8dp" android:background="@drawable/chat_avatar_bg" android:gravity="center"
        android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" />
    <LinearLayout android:id="@+id/bubble" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:background="@drawable/chat_bubble_ai" android:elevation="1dp" android:orientation="vertical"
        android:paddingHorizontal="14dp" android:paddingVertical="10dp">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView android:id="@+id/tvName" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#326FBF" android:textSize="13sp" android:textStyle="bold" />
            <TextView android:id="@+id/tvTag" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="8dp" android:background="@drawable/hm_question_tag" android:paddingHorizontal="8dp"
                android:paddingVertical="1dp" android:text="Question" android:textColor="#9A6200" android:textSize="11.5sp"
                android:textStyle="bold" android:visibility="gone" />
        </LinearLayout>
        <TextView android:id="@+id/messageText" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="3dp" android:lineSpacingMultiplier="1.15" android:textColor="#1C2430" android:textSize="15.5sp" />
        <TextView android:id="@+id/messageInfo" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="end" android:layout_marginTop="4dp" android:textColor="#7A8596" android:textSize="11.5sp" />
    </LinearLayout>
</LinearLayout>
