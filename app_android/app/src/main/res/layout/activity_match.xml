<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#F4F7FB"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ****** TON SCROLLVIEW D’ORIGINE (inchangé) ****** -->
    <ScrollView
        android:fillViewport="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

        <!-- HEADER -->
            <!-- HEADER -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#2C7BE5">

                <LinearLayout
                    android:padding="16dp"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!-- TITRE + TEMPS PASSE -->
                    <LinearLayout
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/tvTitle"
                            android:text="Match de Quiz"
                            android:textColor="@android:color/white"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"/>

                        <TextView
                            android:id="@+id/tvElapsed"
                            android:text="Temps passé : 00:00"
                            android:textColor="@android:color/white"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:layout_marginLeft="8dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvNetStatus"
                        android:text=""
                        android:textColor="#E0E7FF"
                        android:textSize="14sp"
                        android:layout_marginTop="4dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        <!-- SCORE + TIMER -->
        <com.google.android.material.card.MaterialCardView
            android:layout_marginTop="14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="14dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="@android:color/white">

            <LinearLayout
                android:padding="14dp"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tvScore"
                    android:text="Score"
                    android:textStyle="bold"
                    android:textColor="#0F172A"
                    android:textSize="18sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:id="@+id/tvTimer"
                    android:text="60"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp"
                    android:textColor="#F83426"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Info -->
        <TextView
            android:id="@+id/tvInfo"
            android:text="En attente…"
            android:textColor="#0F172A"
            android:layout_marginTop="16dp"
            android:textSize="16sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- List of questions to send -->
        <LinearLayout
            android:id="@+id/listQuestions"
            android:orientation="vertical"
            android:layout_marginTop="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- Options to answer -->
        <LinearLayout
            android:id="@+id/optionsLayout"
            android:orientation="vertical"
            android:layout_marginTop="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- END button -->
        <Button
            android:id="@+id/btnEnd"
            android:text="Quitter le match"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:background="@drawable/corner_btn"
            android:backgroundTint="@color/lavender"
            android:textColor="@android:color/white"
            android:layout_marginTop="18dp"
            android:layout_width="match_parent"
            android:layout_height="56dp"/>
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnOpenChat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        app:srcCompat="@drawable/ic_chat"
        app:tint="@android:color/white"
        app:backgroundTint="#2C7BE5" />
    <TextView
        android:id="@+id/chatBadge"
        android:visibility="gone"
        android:background="@drawable/badge_bg"
        android:textColor="@android:color/white"
        android:textSize="12sp"
        android:padding="4dp"
        android:layout_gravity="bottom|end"
        android:layout_marginRight="14dp"
        android:layout_marginBottom="76dp"
        android:width="22dp"
        android:height="22dp"
        android:gravity="center"
        android:text="1"
      android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <!-- 🟣 POPUP MESSAGE (EN DEHORS du chatBox) -->
    <TextView
        android:id="@+id/tvChatPopup"
        android:visibility="gone"
        android:padding="12dp"
        android:textColor="@android:color/white"
        android:textSize="15sp"
        android:background="@drawable/chat_popup_bg"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="20dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <!-- 🟣 Zone de chat -->
    <!-- 🟣 Zone de chat (ajustée & responsive) -->
    <!-- 🟣 Zone de chat responsive -->
    <LinearLayout
        android:id="@+id/chatBox"
        android:visibility="gone"
        android:orientation="vertical"
        android:background="@drawable/chat_box_bg"
        android:layout_gravity="bottom"
        android:layout_margin="12dp"
        android:padding="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- LISTE DES MESSAGES -->
        <ScrollView
            android:id="@+id/chatScroll"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:overScrollMode="never">

            <LinearLayout
                android:id="@+id/chatMessages"
                android:orientation="vertical"
                android:padding="4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </ScrollView>

        <!-- BARRE DE SAISIE -->
        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- BOUTON ENVOYER A GAUCHE -->
            <ImageButton
                android:id="@+id/btnSendChat"
                android:src="@android:drawable/ic_menu_send"
                android:background="@android:color/transparent"
                android:padding="6dp"
                android:layout_width="36dp"
                android:layout_height="36dp"/>

            <!-- CHAMP DE TEXTE -->
            <EditText
                android:id="@+id/etChatMessage"
                android:hint="Écrire ici…"
                android:background="@null"
                android:textSize="15sp"
                android:padding="10dp"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"/>
        </LinearLayout>

    </LinearLayout>

</FrameLayout>