<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_marginBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:backgroundTint="@color/surface"
    android:padding="16dp">

    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- 🔥 Rang -->
        <TextView
            android:id="@+id/tvRank"
            android:text="#1"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/on_surface"
            android:layout_marginEnd="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <!-- 🔥 Colonne info joueur -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <!-- Nom -->
            <TextView
                android:id="@+id/tvName"
                android:text="Nom du joueur"
                android:textColor="@color/on_surface"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />



            <!-- Victoires -->
            <TextView
                android:id="@+id/tvWins"
                android:text="Victoires: 5"
                android:textColor="@color/on_surface_variant"
                android:textSize="14sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <!-- Adversaires uniques -->
            <TextView
                android:id="@+id/tvUnique"
                android:text="Adversaires uniques: 3"
                android:textColor="@color/on_surface_variant"
                android:textSize="14sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <!-- Matchs joués -->
            <TextView
                android:id="@+id/tvPlayed"
                android:text="Matchs joués: 0"
                android:textColor="@color/on_surface_variant"
                android:textSize="14sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <!-- Matchs gagnés -->
            <TextView
                android:id="@+id/tvWon"
                android:text="Matchs gagnés: 0"
                android:textColor="@color/on_surface_variant"
                android:textSize="14sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <!-- Matchs perdus -->
            <TextView
                android:id="@+id/tvLost"
                android:text="Matchs perdus: 0"
                android:textColor="@color/on_surface_variant"
                android:textSize="14sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </LinearLayout>
        <!-- 🔥 Status en ligne (aligné à gauche) -->
        <TextView
            android:id="@+id/tvStatus"
            android:text="🟢 Disponible"
            android:textSize="10sp"
            android:textColor="@color/on_surface_variant"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp" />


    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
