<?xml version="1.0" encoding="utf-8"?>
<!-- Historique et progression des quiz -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F4F6FA">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingBottom="24dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/hm_header" android:orientation="vertical"
            android:paddingHorizontal="20dp" android:paddingTop="28dp" android:paddingBottom="40dp">
            <TextView style="@style/HM.HeaderTitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Ma progression aux quiz" />
            <TextView android:id="@+id/tvGlobalRatio" style="@style/HM.HeaderSub" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Réussite globale : 0 %" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp" android:layout_marginTop="-24dp" android:background="@drawable/hm_card"
            android:elevation="3dp" android:orientation="vertical" android:padding="18dp">
            <TextView style="@style/HM.Muted" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Bonnes réponses" />
            <ProgressBar android:id="@+id/pbCorrect" style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="6dp"
                android:progressTint="#1E9E62" android:progressBackgroundTint="#D8EFE3" />
            <TextView style="@style/HM.Muted" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="14dp" android:text="Mauvaises réponses" />
            <ProgressBar android:id="@+id/pbWrong" style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="6dp"
                android:progressTint="#D64545" android:progressBackgroundTint="#F6DADA" />
            <TextView android:id="@+id/tvEval" style="@style/HM.Body" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="14dp"
                android:text="Commencez un quiz pour voir votre évaluation." />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp" android:layout_marginTop="12dp" android:background="@drawable/hm_card"
            android:orientation="vertical" android:padding="18dp">
            <TextView android:id="@+id/tvAnswered" style="@style/HM.Title" android:textSize="17sp"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Questions répondues : 0" />
            <TextView android:id="@+id/tvScoreHist" style="@style/HM.Body" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="#1E9E62" android:text="Bonnes réponses : 0" />
            <TextView android:id="@+id/tvWrong" style="@style/HM.Body" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textColor="#D64545" android:text="Mauvaises réponses : 0" />
            <TextView android:id="@+id/tvLeft" style="@style/HM.Muted" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="Questions restantes : 0" />
        </LinearLayout>

        <TextView style="@style/HM.Title" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="20dp" android:layout_marginTop="22dp" android:text="Par catégorie" />
        <LinearLayout android:id="@+id/categoryContainer" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginHorizontal="16dp" android:layout_marginTop="6dp"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
