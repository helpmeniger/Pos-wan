<?xml version="1.0" encoding="utf-8"?>
<!-- Réponse proposée au quiz : lettre A-D + texte (hauteur libre pour les réponses longues) -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardOption"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:rippleColor="#33326FBF"
    app:strokeColor="#DCE3EE"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="58dp"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp">

        <TextView
            android:id="@+id/tvLetter"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/hm_letter_circle"
            android:gravity="center"
            android:text="A"
            android:textColor="#1F4F96"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvOptionText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:lineSpacingMultiplier="1.1"
            android:paddingStart="14dp"
            android:text="Réponse"
            android:textColor="#1B2330"
            android:textSize="16sp" />

        <!-- conservé pour la compatibilité (non affiché) -->
        <RadioButton
            android:id="@+id/rbOption"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
