<?xml version="1.0" encoding="utf-8"?>
<!-- Connexion HELP-ME (sert aussi d'écran d'attente au démarrage) -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6FA"
    android:fillViewport="true"
    tools:context=".Login">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Bandeau : logo et nom -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/hm_header"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="56dp"
            android:paddingBottom="76dp">

            <FrameLayout
                android:layout_width="108dp"
                android:layout_height="108dp"
                android:background="@drawable/hm_logo_ring"
                android:elevation="8dp">

                <ImageView
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:layout_gravity="center"
                    android:contentDescription="Logo HELP-ME"
                    android:scaleType="fitCenter"
                    android:src="@drawable/logobook" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.04"
                android:text="HELP-ME"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Apprendre l’informatique de bureau"
                android:textColor="#DCE7F7"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Carte : formulaire ou attente -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="18dp"
            android:layout_marginTop="-44dp"
            android:animateLayoutChanges="true"
            android:background="@drawable/hm_card"
            android:elevation="6dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="22dp"
            android:paddingTop="24dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/tvWelcome"
                style="@style/HM.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Bienvenue ! Identifiez-vous pour retrouver vos cours."
                android:textSize="18sp" />

            <!-- Message d'état (attente) -->
            <TextView
                android:id="@+id/textStatus"
                style="@style/HM.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="Ouverture de votre espace…"
                android:textSize="18sp"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="180dp"
                android:layout_height="6dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="6dp"
                android:indeterminate="true"
                android:indeterminateTint="#326FBF"
                android:visibility="gone" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/textInputLayoutEmail"
                style="@style/HM.Field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:hint="Nom et domaine"
                app:startIconDrawable="@drawable/ic_person_24">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textEmailAddress" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/textInputLayoutPassword"
                style="@style/HM.Field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Numéro de téléphone"
                app:startIconDrawable="@drawable/ic_phone_24">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="phone" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_login"
                style="@style/HM.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Valider mon accès"
                app:icon="@drawable/ic_lock_24"
                app:iconGravity="textStart"
                app:iconTint="#FFFFFF" />

            <TextView
                android:id="@+id/registerNow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:padding="6dp"
                android:text="Besoin d’aide ? Contactez le support HELP-ME"
                android:textColor="#326FBF"
                android:textSize="14.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvSupport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.3"
            android:text="Assistance : +227 92 08 12 82\nbureau@helpme.ne"
            android:textColor="#667386"
            android:textSize="13.5sp" />
    </LinearLayout>
</ScrollView>
