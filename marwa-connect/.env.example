# MARWA CONNECT — exemple de configuration.
# Le fichier .env est normalement généré par l'assistant d'installation (/install).
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost/marwa-connect
APP_TIMEZONE=Africa/Niamey
# Clé maître de chiffrement (générée à l'installation). NE JAMAIS LA PERDRE NI LA CHANGER :
# les mots de passe API des routeurs et des tickets deviendraient illisibles.
APP_KEY=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=marwa_connect
DB_USERNAME=root
DB_PASSWORD=

LOG_LEVEL=info
SESSION_IDLE_MINUTES=30
SESSION_LIFETIME_MINUTES=720
SESSION_SECURE_COOKIE=false
TRUST_PROXY=false

# Facultatif : chemin vers mysqldump.exe pour des sauvegardes plus rapides
MYSQLDUMP_PATH=
MIKROTIK_TIMEOUT=5
